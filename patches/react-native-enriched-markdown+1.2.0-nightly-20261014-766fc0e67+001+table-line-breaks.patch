+static BOOL ENRMTableIsOpaqueForLineBreak(MarkdownNodeType type)
+{
+  return type == MarkdownNodeTypeCode || type == MarkdownNodeTypeCodeBlock || type == MarkdownNodeTypeImage ||
+         type == MarkdownNodeTypeVideo || type == MarkdownNodeTypeLatexMathInline ||
+         type == MarkdownNodeTypeLatexMathDisplay;
+}
