+static NSArray<MarkdownASTNode *> *ENRMTableSplitTextLineBreaks(MarkdownASTNode *textNode)
+{
+  NSString *content = textNode.content;
+  if (!content || [content rangeOfString:@"\u2028"].location == NSNotFound) {
+    return nil;
+  }
+  NSMutableArray<MarkdownASTNode *> *result = [NSMutableArray array];
+  NSUInteger length = content.length;
+  NSUInteger segStart = 0;
+  NSUInteger i = 0;
+  while (i < length) {
+    if ([content characterAtIndex:i] == 0x2028) {
+      NSUInteger segEnd = i;
+      while (segEnd > segStart) {
+        unichar prev = [content characterAtIndex:segEnd - 1];
+        if (prev != ' ' && prev != '\t')
+          break;
+        segEnd--;
+      }
+      if (segEnd > segStart) {
+        MarkdownASTNode *piece = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+        piece.content = [content substringWithRange:NSMakeRange(segStart, segEnd - segStart)];
+        if (textNode.attributes.count > 0) {
+          piece.attributes = [textNode.attributes mutableCopy];
+        }
+        [result addObject:piece];
+      }
+      [result addObject:[[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeLineBreak]];
+      i++;
+      while (i < length) {
+        unichar next = [content characterAtIndex:i];
+        if (next != ' ' && next != '\t')
+          break;
+        i++;
+      }
+      segStart = i;
+    } else {
+      i++;
+    }
+  }
+  if (segStart < length) {
+    MarkdownASTNode *tail = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+    tail.content = [content substringFromIndex:segStart];
+    if (textNode.attributes.count > 0) {
+      tail.attributes = [textNode.attributes mutableCopy];
+    }
+    [result addObject:tail];
+  }
+  return result;
+}
