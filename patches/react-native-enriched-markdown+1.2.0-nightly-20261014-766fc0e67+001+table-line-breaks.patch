+static MarkdownASTNode *ENRMTableExpandLineBreaksInNode(MarkdownASTNode *node)
+{
+  if (!node || node.children.count == 0 || ENRMTableIsOpaqueForLineBreak(node.type)) {
+    return node;
+  }
+  BOOL changed = NO;
+  NSMutableArray<MarkdownASTNode *> *newChildren = [NSMutableArray arrayWithCapacity:node.children.count];
+  for (MarkdownASTNode *child in node.children) {
+    if (child.type == MarkdownNodeTypeText) {
+      NSArray<MarkdownASTNode *> *split = ENRMTableSplitTextLineBreaks(child);
+      if (split) {
+        changed = YES;
+        [newChildren addObjectsFromArray:split];
+        continue;
+      }
+    }
+    MarkdownASTNode *expanded = ENRMTableExpandLineBreaksInNode(child);
+    if (expanded != child) {
+      changed = YES;
+    }
+    [newChildren addObject:expanded];
+  }
+  if (!changed) {
+    return node;
+  }
+  MarkdownASTNode *copy = [[MarkdownASTNode alloc] initWithType:node.type];
+  copy.content = node.content;
+  if (node.attributes.count > 0) {
+    copy.attributes = [node.attributes mutableCopy];
+  }
+  copy.children = newChildren;
+  return copy;
